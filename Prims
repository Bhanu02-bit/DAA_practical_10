# Find the parent vertex
def find(parent, vertex):
    if parent[vertex] != vertex:
        parent[vertex] = find(parent, parent[vertex])  # Path compression
    return parent[vertex]

# Joins two sets 
def union(parent, u, v):
    u_root = find(parent, u)
    v_root = find(parent, v)
    if u_root != v_root:
        parent[v_root] = u_root

# Kruskal's Algorithm
def kruskal(edges, n):
    # Sort edges based on weight (weight is at index 2)
    edges.sort(key=lambda x: x[2])

    # Initialize parent array where each vertex is its own representative
    parent = list(range(n + 1))

    mst = []
    total_cost = 0

    # Iterate through sorted edges
    for u, v, weight in edges:
        # Check if adding this edge creates a cycle
        if find(parent, u) != find(parent, v):
            mst.append((u, v, weight))
            total_cost += weight
            union(parent, u, v)

            # A spanning tree with n vertices always has n-1 edges
            if len(mst) == n - 1:
                break

    return total_cost, mst

if __name__ == "__main__":
    n = 4  
    edges = [
        (1, 2, 10),
        (1, 3, 6),
        (1, 4, 5),
        (2, 4, 15),
        (3, 4, 4)
    ]

    cost, mst_edges = kruskal(edges, n)
    print(f"Total Minimum Cost: {cost}")
    print(f"Edges in MST: {mst_edges}")
